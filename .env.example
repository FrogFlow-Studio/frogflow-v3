# Окружение описывает платформу, не клиента. Всё про клиента — в базе (bots).
APP_URL=https://app.frogflow.kz

SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Settings → API → JWT Secret (legacy HS256). Им подписываются ключи арендаторов на каждый запрос.
SUPABASE_JWT_SECRET=

# 32 байта: openssl rand -hex 32
SECRETS_KEY=
SESSION_SECRET=
WEBHOOK_SECRET=
CRON_SECRET=

# Запасной вход оператора только для первого входа: учётка хранится в базе
# (Панель оператора → Настройки). После смены пароля эти строки можно удалить.
OPERATOR_USERNAME=operator
OPERATOR_PASSWORD=

# Публичная регистрация продавцов на /signup: 1 — включена, 0 — выключена
SIGNUP_ENABLED=0
# Режим предпросмотра: 1 — кроны и вебхуки отвечают 200 без работы; выключены
# отправка в Telegram, Zernio, почту и push, вызовы ИИ (Anthropic), Google Vision
# и счета ApiPay. Запись в базу из панелей остаётся: сборку можно открыть на общей
# базе, но продавец и оператор в ней меняют данные, как обычно
PREVIEW_READONLY=0
# Прокси Bot API, если нужен; по умолчанию https://api.telegram.org
# TELEGRAM_API_BASE=

# Один аккаунт Zernio на платформу; профили клиентов — в bots.settings.zernio
ZERNIO_API_KEY=
ZERNIO_WEBHOOK_SECRET=

# ApiPay (apipay.kz): ссылка на оплату счетов платформы через Kaspi.
# Вебхук в кабинете ApiPay: <APP_URL>/api/apipay/webhook
APIPAY_API_KEY=
APIPAY_WEBHOOK_SECRET=
# 1 — боевой режим; иначе песочница, ссылку получает только этот магазин
APIPAY_LIVE=0
APIPAY_SANDBOX_BOT_ID=
# Адрес API ApiPay; по умолчанию https://api.apipay.kz/api/v1
# APIPAY_BASE_URL=

ANTHROPIC_API_KEY=
# Консультант по прайсу (BOVI): ретранслятор курса ВТБ внутри Казахстана (необязательно).
CONSULTANT_VTB_RELAY_URL=
GOOGLE_VISION_API_KEY=

# Push-уведомления админки (PWA): ключи VAPID, сгенерировать один раз:
# node -e "const c=require('crypto');const k=c.generateKeyPairSync('ec',{namedCurve:'P-256'});const j=k.privateKey.export({format:'jwk'});console.log('VAPID_PUBLIC_KEY='+Buffer.concat([Buffer.from([4]),Buffer.from(j.x,'base64url'),Buffer.from(j.y,'base64url')]).toString('base64url'));console.log('VAPID_PRIVATE_KEY='+j.d)"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@frogflow.kz
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

APP_TIMEZONE=Asia/Almaty

# Учёт ошибок: DSN проекта Sentry (или GlitchTip). Пусто — только журнал функции.
SENTRY_DSN=

# Яндекс Вебмастер: значение метатега yandex-verification (только код, без тега).
# Пусто — тега на главной нет.
YANDEX_VERIFICATION=
