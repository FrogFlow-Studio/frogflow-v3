# Окружение описывает платформу, не клиента. Всё про клиента — в базе (bots).
APP_URL=https://app.frogflow.kz

SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Settings → API → JWT Secret (legacy HS256). Им подписываются ключи арендаторов на каждый запрос.
SUPABASE_JWT_SECRET=

# 32 байта: openssl rand -hex 32
SECRETS_KEY=
SESSION_SECRET=
WEBHOOK_SECRET=
CRON_SECRET=

# Запасной вход оператора только для первого входа: учётка хранится в базе
# (Панель оператора → Настройки). После смены пароля эти строки можно удалить.
OPERATOR_USERNAME=operator
OPERATOR_PASSWORD=

# Публичная регистрация продавцов на /signup: 1 — включена, 0 — выключена
SIGNUP_ENABLED=1
# Прокси Bot API, если нужен; по умолчанию https://api.telegram.org
# TELEGRAM_API_BASE=

# Один аккаунт Zernio на платформу; профили клиентов — в bots.settings.zernio
ZERNIO_API_KEY=
ZERNIO_WEBHOOK_SECRET=

ANTHROPIC_API_KEY=
GOOGLE_VISION_API_KEY=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

APP_TIMEZONE=Asia/Almaty
