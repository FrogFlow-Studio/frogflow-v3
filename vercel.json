{
  "buildCommand": "npm run build",
  "outputDirectory": ".vercel/output",
  "installCommand": "npm install --legacy-peer-deps",
  "framework": "tanstack-start",
  "trailingSlash": false,
  "regions": ["icn1"],
  "crons": [
    { "path": "/api/cron/ensure-webhook", "schedule": "0 * * * *" },
    { "path": "/api/cron/broadcast", "schedule": "* * * * *" },
    { "path": "/api/cron/cart-reminder", "schedule": "*/30 * * * *" },
    { "path": "/api/cron/fulfillment-reminder", "schedule": "0 * * * *" },
    { "path": "/api/cron/retention", "schedule": "20 3 * * *" },
    { "path": "/api/cron/vip", "schedule": "*/10 * * * *" }
  ]
}
